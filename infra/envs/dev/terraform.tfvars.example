region      = "ap-southeast-2"
project     = "otel-gitops"
environment = "dev"

# GitHub repository that will assume the CI roles. The name is case-sensitive
# in the OIDC subject and must match the repository exactly.
github_owner = "jjyy032659"
github_repo  = "Opentelemetry"

# Bucket and lock table created by infra/bootstrap.
state_bucket_name = "otel-gitops-ACCOUNT_ID-tfstate"
lock_table_name   = "otel-gitops-tf-locks"

# Hosted zone you already have for a domain you own. This stack does not
# register a domain or create the zone.
hosted_zone_id = "Z0123456789ABCDEFGHIJ"
app_hostname   = "shop.example.com"

# Leave both empty on the first apply. Fill them in after the ingress has
# an address, then apply again to create the Route 53 alias.
alb_dns_name = ""
alb_zone_id  = ""

# Set to false if this AWS account already has a GitHub OIDC provider
# (only one provider for token.actions.githubusercontent.com is allowed).
create_github_oidc_provider = true

# Confirm the version is still offered in this region before apply.
cluster_version = "1.35"
